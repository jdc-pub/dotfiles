Include config.d/*

Host tars
  HostName tars
  ProxyCommand tailscale nc %h %p
  RemoteForward /run/user/1000/gnupg/S.gpg-agent %d/.gnupg/S.gpg-agent.extra

# Opt-in Rex tunnel to tars: `ssh -fN tars-rex` to start, `ssh -O exit tars-rex` to stop
Host tars-rex
  HostName tars
  ProxyCommand tailscale nc %h %p
  LocalForward /Users/joey/.ssh/tars-rex.sock /run/user/1000/rex/server.sock
  StreamLocalBindUnlink yes
  ExitOnForwardFailure yes
  ServerAliveInterval 30
  ControlMaster auto
  ControlPath ~/.ssh/cm-%C
  ControlPersist no
  RequestTTY no
