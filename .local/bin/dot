#!/bin/sh
# Manage dotfiles: a git repo in ~/.local/share/dot whose work tree is $HOME.
# Usage: dot status | dot add -f ~/.bashrc | dot commit | dot push ...
case "$1" in
  clean) echo "dot: refusing 'clean': the work tree is \$HOME" >&2; exit 1 ;;
esac
exec git --git-dir="$HOME/.local/share/dot" --work-tree="$HOME" "$@"
